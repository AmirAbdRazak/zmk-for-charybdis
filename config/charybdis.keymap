#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NUM  1
#define SYM  2
#define FUN  3
#define NAV  4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <90>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hs: homerow_mods_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        tab_esc: tab_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <90>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        s_all: s_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp HOME>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp END>
                , <&macro_release &kp LSHFT>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp W       &kp G       &kp D        &kp F        &kp B             &kp Q    &kp L        &kp U        &kp O       &kp Y
&hs LGUI R  &hm LALT S  &hm LSHFT T  &hm LCTRL H  &kp K             &kp J    &hm RCTRL N  &hm RSHFT E  &hm LALT A  &hs RGUI I
&kp X       &kp C       &kp M        &kp P        &kp V             &kp Z    &kp COMMA    &kp DOT      &kp SQT     &kp FSLH
                        &sl NUM      &kp SPACE    &tab_esc TAB ESC  &kp RET  &sl SYM      &to NAV
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&trans  &trans    &trans     &kp CAPS   &trans    &trans   &kp N1    &kp N2  &kp N3  &trans
&trans  &kp LALT  &kp LSHFT  &kp LCTRL  &trans    &trans   &kp N4    &kp N5  &kp N6  &trans
&trans  &trans    &trans     &trans     &trans    &trans   &kp N7    &kp N8  &kp N9  &trans
                  &trans     &trans     &trans    &mo FUN  &to BASE  &kp N0
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&trans    &kp GRAVE  &kp UNDER  &kp MINUS  &trans    &trans  &kp EXCL  &kp AT     &kp HASH   &trans
&kp LGUI  &kp LALT   &kp LSHFT  &kp LCTRL  &trans    &trans  &kp DLLR  &kp PRCNT  &kp CARET  &trans
&trans    &kp TILDE  &kp EQUAL  &kp PLUS   &trans    &trans  &kp AMPS  &kp STAR   &trans     &trans
                     &kp BSLH   &kp PIPE   &trans    &trans  &to BASE  &trans
            >;
        };

        function_layer {
            display-name = "Fun";
            bindings = <
&sys_reset   &bt BT_CLR  &out OUT_USB  &out OUT_BLE  &bt BT_SEL 0    &kp DEL  &kp F1  &kp F2  &kp F3  &kp F10
&bootloader  &kp LALT    &kp LSHFT     &kp LCTRL     &bt BT_SEL 1    &kp INS  &kp F4  &kp F5  &kp F6  &kp F11
&trans       &trans      &bt BT_PRV    &bt BT_NXT    &bt BT_SEL 2    &trans   &kp F7  &kp F8  &kp F9  &kp F12
                         &trans        &trans        &trans          &trans   &trans  &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans    &trans    &trans     &trans     &trans    &trans  &kp HOME   &kp UP    &kp END    &trans
&kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &trans    &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &trans
&trans    &trans    &trans     &trans     &trans    &trans  &kp PG_UP  &trans    &kp PG_DN  &trans
                    &trans     &trans     &trans    &trans  &trans     &trans
            >;
        };
    };
};
